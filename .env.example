# Supabase server-only credentials. Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini server-only keys. AI Studio falls back to GEMINI_API_KEY_DEFAULT.
GEMINI_API_KEY_DEFAULT=
GEMINI_API_KEY_AI_STUDIO=
GEMINI_API_KEY_DAILY_REPORT=

# Optional model overrides; leave blank to use the app defaults/fallbacks.
GEMINI_MODEL_DEFAULT=
GEMINI_MODEL_AI_STUDIO=
GEMINI_MODEL_DAILY_REPORT=

# Required only for production owner access.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=

# Optional hosted scheduler authorization.
CRON_SECRET=
SCHEDULED_JOB_SECRET=